#pragma once

// Template for secret credentials.
//
// Copy this file to credentials.h and fill in your real values:
//     cp include/credentials.h.example include/credentials.h
//
// credentials.h is gitignored and must never be committed.

// WiFi network the ESP32 joins (2.4 GHz; the ESP32-WROOM-32 has no 5 GHz radio).
#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// MQTT broker connection. For HiveMQ Cloud, use the cluster URL shown in the
// console (Overview > Connection Settings) and TLS port 8883.
#define MQTT_HOST "xxxxxxxxxxxx.s1.eu.hivemq.cloud"
#define MQTT_PORT 8883

// Broker authentication. HiveMQ Cloud requires a username/password created
// under Access Management. Leave both as "" only for an anonymous broker.
#define MQTT_USER "your-hivemq-username"
#define MQTT_PASSWORD "your-hivemq-password"
